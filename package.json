{
  "name": "antigravity-interactive-form-planner-planning-tool",
  "displayName": "Orbit",
  "description": "Orbit : Ultimate planning tool for antigravity.",
  "version": "0.2.7",
  "publisher": "VNTRCORP",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Venturi-exe/Interactive-Form-Planner-for-Antigravity.git"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "antigravity",
    "mcp",
    "interactive",
    "forms",
    "agent",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orbit-container",
          "title": "Orbit",
          "icon": "$(symbol-parameter)"
        }
      ]
    },
    "views": {
      "orbit-container": [
        {
          "type": "webview",
          "id": "orbit.formView",
          "name": "Orbit Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "orbit.showPanel",
        "title": "Orbit: Show Panel"
      },
      {
        "command": "orbit.testPlanner",
        "title": "Orbit: Planner Demo (All Field Types + Execute Button)"
      },
      {
        "command": "orbit.testCartograph",
        "title": "Orbit: Cartograph Demo (Push Mock Impact Reports)"
      },
      {
        "command": "orbit.openSettings",
        "title": "Orbit: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "orbit.openMainTab",
        "title": "Orbit: Maximize Panel View",
        "icon": "$(screen-full)"
      },
      {
        "command": "orbit.openMainTabPlanner",
        "title": "Orbit: Open Planner in Main Tab"
      },
      {
        "command": "orbit.openMainTabCartograph",
        "title": "Orbit: Open Cartograph in Main Tab"
      },
      {
        "command": "orbit.openHub",
        "title": "Orbit: Open Cartograph Hub",
        "icon": "$(dashboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "orbit.openMainTab",
          "when": "view == orbit.formView",
          "group": "navigation@0"
        },
        {
          "command": "orbit.openSettings",
          "when": "view == orbit.formView",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Orbit Settings",
      "properties": {
        "orbit.inactivityTimeout": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Inactivity timeout threshold in minutes for the pre-execution planning form before automatically triggering a timeout."
        },
        "orbit.countdownWarningThreshold": {
          "type": "integer",
          "default": 60,
          "minimum": 5,
          "maximum": 300,
          "description": "Countdown warning threshold in seconds before inactivity timeout is triggered."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build-webview": "node esbuild.js",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js",
    "package": "npx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run typecheck && npm run lint && npm test && node esbuild.js --production",
    "vscode:uninstall": "node ./out/uninstall.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.96.0",
    "@xyflow/react": "^12.0.0",
    "dagre": "^0.8.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jsonc-parser": "^3.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^3.24.0"
  },
  "dependencies": {}
}
